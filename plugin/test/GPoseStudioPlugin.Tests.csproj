<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- Pure-logic files only; these have NO Dalamud/game dependency, so the
         suite runs anywhere (including the dev environment). -->
    <Compile Include="..\src\Png.cs" />
    <Compile Include="..\src\LookName.cs" />
    <Compile Include="..\src\LookParts.cs" />
    <Compile Include="..\src\PackedArray.cs" />
    <Compile Include="..\src\Frame.cs" />
    <Compile Include="..\src\BuiltinGuard.cs" />
    <Compile Include="..\src\ZoneBits.cs" />
    <Compile Include="..\src\ElementImages.cs" />
    <!-- The two files a look actually round-trips through. They reach Dalamud in a
         handful of spots, so TestServices.cs stands in for it: the seam is in the
         build, not in the shipped code. -->
    <Compile Include="..\src\PluginConfig.cs" />
    <Compile Include="..\src\LookStore.cs" />
    <Compile Include="TestServices.cs" />
    <Compile Include="PngTests.cs" />
    <Compile Include="PngEmbedTests.cs" />
    <Compile Include="LookNameTests.cs" />
    <Compile Include="LookPartsTests.cs" />
    <Compile Include="PackedArrayTests.cs" />
    <Compile Include="FrameTests.cs" />
    <Compile Include="BuiltinGuardTests.cs" />
    <Compile Include="LookRoundTripTests.cs" />
    <Compile Include="ZoneBitsTests.cs" />
    <Compile Include="ElementImagesTests.cs" />
    <Compile Include="ElementLayerTests.cs" />
    <Compile Include="BuiltinSetTests.cs" />
    <Compile Include="TextMarkerTests.cs" />
  </ItemGroup>
</Project>
